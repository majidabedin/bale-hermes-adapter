# ── Bale Bot Configuration ─────────────────────────────────────────
# Get your token from @BotFather on Bale messenger
BALE_BOT_TOKEN=your_bot_token_here

# Comma-separated Bale user IDs allowed to message the bot
# Leave empty to allow all users
BALE_ALLOWED_USERS=your_bale_user_id_here

# Optional: Default chat_id for cron/notification delivery
# BALE_HOME_CHANNEL=your_chat_id_here
